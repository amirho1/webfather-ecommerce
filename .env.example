PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=file:./webfather-ecommerce.db
REDIS_URL=redis://localhost:6379

COMPANY_NAME="مفت خر"
SITE_NAME="مفت خر"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Mobile OTP via Melipayamak (Modern Console Token / JWT preferred)
MELIPAYAMAK_JWT=
TEST_PHONE_NUMBER=

# Legacy Melipayamak Payamak-Panel SendOtp credentials (fallback if JWT not provided)
MELIPAYAMAK_USERNAME=98
MELIPAYAMAK_CREDENTIAL=
MELIPAYAMAK_FROM=

# Dokploy uses its Domains tab to route the public domain to container port 4000.
# Keep these volume names stable to retain production data across deployments.
# SQLITE_VOLUME_NAME=webfather_sqlite_data
# MEDIA_VOLUME_NAME=webfather_media_data
# For local Compose use without dokploy-network, set both values below.
# DOCKER_PROXY_NETWORK=webfather-local
# DOCKER_PROXY_NETWORK_EXTERNAL=false

# Used to preview drafts
PREVIEW_SECRET=replace-with-a-second-random-secret
